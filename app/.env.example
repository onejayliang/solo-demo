# Application Configuration
APP_NAME=宗亲寻根·薪火相传
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security Configuration - IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zongqin_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=zongqin

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Object Storage (S3 compatible)
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
S3_BUCKET=zongqin-storage

# Password Hashing
BCRYPT_ROUNDS=12
